package com.soulther.init;

import com.soulther.SoultherMod;
import net.minecraft.resources.ResourceKey;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.level.Level;
import net.minecraft.world.level.dimension.DimensionType;

/**
 * Soulther boyutu için ResourceKey sabitleri.
 * Gerçek boyut tanımı data/soulther/dimension/soulther.json içindedir (datapack).
 */
public class ModDimensions {

    public static final ResourceKey<Level> SOULTHER_LEVEL_KEY = ResourceKey.create(
            net.minecraft.core.registries.Registries.DIMENSION,
            new ResourceLocation(SoultherMod.MOD_ID, "soulther"));

    public static final ResourceKey<DimensionType> SOULTHER_DIMENSION_TYPE_KEY = ResourceKey.create(
            net.minecraft.core.registries.Registries.DIMENSION_TYPE,
            new ResourceLocation(SoultherMod.MOD_ID, "soulther_type"));
}
