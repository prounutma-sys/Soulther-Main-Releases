package com.soulther.fluid;

import net.minecraft.resources.ResourceLocation;
import net.minecraftforge.client.extensions.common.IClientFluidTypeExtensions;
import net.minecraftforge.fluids.FluidType;

/** Liquid Soul için client-taraflı görsel özellikler (doku konumları). */
public class SoultherFluidType extends FluidType {

    public SoultherFluidType(Properties properties) {
        super(properties);
    }

    public static IClientFluidTypeExtensions clientExtensions() {
        return new IClientFluidTypeExtensions() {
            private static final ResourceLocation STILL =
                    new ResourceLocation("soulther", "block/liquid_soul_still");
            private static final ResourceLocation FLOWING =
                    new ResourceLocation("soulther", "block/liquid_soul_flow");

            @Override
            public ResourceLocation getStillTexture() {
                return STILL;
            }

            @Override
            public ResourceLocation getFlowingTexture() {
                return FLOWING;
            }

            @Override
            public int getTintColor() {
                return 0xFF5A2A83; // mor-eflatun ruh rengi
            }
        };
    }
}
