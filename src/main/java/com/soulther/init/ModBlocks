package com.soulther.init;

import com.soulther.SoultherMod;
import com.soulther.portal.SoultherPortalBlock;
import net.minecraft.sounds.SoundType;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.LiquidBlock;
import net.minecraft.world.level.block.state.BlockBehaviour;
import net.minecraft.world.level.material.MapColor;
import net.minecraftforge.registries.DeferredRegister;
import net.minecraftforge.registries.ForgeRegistries;
import net.minecraftforge.registries.RegistryObject;

public class ModBlocks {

    public static final DeferredRegister<Block> BLOCKS =
            DeferredRegister.create(ForgeRegistries.BLOCKS, SoultherMod.MOD_ID);

    // ---- Taş / Zemin Blokları ----
    public static final RegistryObject<Block> SOULTHER_STONE = BLOCKS.register("soulther_stone",
            () -> new Block(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_PURPLE)
                    .strength(2.0f, 6.0f)
                    .sound(SoundType.STONE)
                    .requiresCorrectToolForDrops()));

    public static final RegistryObject<Block> SOULTHER_GRASS = BLOCKS.register("soulther_grass",
            () -> new Block(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_LIGHT_GRAY)
                    .strength(0.6f)
                    .sound(SoundType.SOUL_SOIL)));

    // ---- Cevherler ----
    public static final RegistryObject<Block> SOULTHER_ORE = BLOCKS.register("soulther_ore",
            () -> new Block(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_CYAN)
                    .strength(4.5f, 8.0f)
                    .sound(SoundType.NETHERITE_BLOCK)
                    .requiresCorrectToolForDrops()
                    .lightLevel(state -> 7)));

    public static final RegistryObject<Block> SOULTHER_BLOCK = BLOCKS.register("soulther_block",
            () -> new Block(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_CYAN)
                    .strength(6.0f, 10.0f)
                    .sound(SoundType.NETHERITE_BLOCK)
                    .requiresCorrectToolForDrops()));

    // ---- Ahşap / bitki örtüsü ----
    public static final RegistryObject<Block> SOULTHER_LOG = BLOCKS.register("soulther_log",
            () -> new Block(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_PURPLE)
                    .strength(2.0f)
                    .sound(SoundType.WOOD)));

    public static final RegistryObject<Block> SOULTHER_LEAVES = BLOCKS.register("soulther_leaves",
            () -> new Block(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_PURPLE)
                    .strength(0.3f)
                    .sound(SoundType.AZALEA_LEAVES)
                    .noOcclusion()));

    // ---- Portal sistemi ----
    // Portali açmak için gereken çerçeve bloğu: Warden Kalbi (Warden Heart) parçalarından yapılır.
    public static final RegistryObject<Block> WARDEN_HEART_BLOCK = BLOCKS.register("warden_heart_block",
            () -> new Block(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_BLACK)
                    .strength(50.0f, 1200.0f)
                    .sound(SoundType.SCULK)
                    .lightLevel(state -> 10)
                    .requiresCorrectToolForDrops()));

    // Gerçek portal bloğu (girilebilir, ışınlayan blok)
    public static final RegistryObject<Block> SOULTHER_PORTAL = BLOCKS.register("soulther_portal",
            () -> new SoultherPortalBlock(BlockBehaviour.Properties.of()
                    .mapColor(MapColor.COLOR_BLACK)
                    .noCollission()
                    .strength(-1.0f)
                    .sound(SoundType.GLASS)
                    .lightLevel(state -> 15)
                    .noLootTable()));

    // ---- Sıvı bloğu ----
    public static final RegistryObject<LiquidBlock> LIQUID_SOUL_BLOCK = BLOCKS.register("liquid_soul",
            () -> new LiquidBlock(() -> (net.minecraft.world.level.material.FlowingFluid) ModFluids.LIQUID_SOUL_SOURCE.get(),
                    BlockBehaviour.Properties.of()
                            .mapColor(MapColor.COLOR_PURPLE)
                            .noCollission()
                            .strength(100.0f)
                            .lightLevel(state -> 6)
                            .noLootTable()));
}
