package com.soulther.init;

import com.soulther.SoultherMod;
import com.soulther.entity.SoulWraithEntity;
import com.soulther.entity.SoultherDragonEntity;
import com.soulther.entity.VoidlingEntity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.MobCategory;
import net.minecraftforge.event.entity.EntityAttributeCreationEvent;
import net.minecraftforge.registries.DeferredRegister;
import net.minecraftforge.registries.ForgeRegistries;
import net.minecraftforge.registries.RegistryObject;

public class ModEntities {

    public static final DeferredRegister<EntityType<?>> ENTITY_TYPES =
            DeferredRegister.create(ForgeRegistries.ENTITY_TYPES, SoultherMod.MOD_ID);

    public static final RegistryObject<EntityType<SoulWraithEntity>> SOUL_WRAITH = ENTITY_TYPES.register("soul_wraith",
            () -> EntityType.Builder.of(SoulWraithEntity::new, MobCategory.MONSTER)
                    .sized(0.7F, 1.3F)
                    .clientTrackingRange(10)
                    .build("soul_wraith"));

    public static final RegistryObject<EntityType<VoidlingEntity>> VOIDLING = ENTITY_TYPES.register("voidling",
            () -> EntityType.Builder.of(VoidlingEntity::new, MobCategory.MONSTER)
                    .sized(0.6F, 1.8F)
                    .clientTrackingRange(10)
                    .build("voidling"));

    public static final RegistryObject<EntityType<SoultherDragonEntity>> SOULTHER_DRAGON = ENTITY_TYPES.register("soulther_dragon",
            () -> EntityType.Builder.of(SoultherDragonEntity::new, MobCategory.MONSTER)
                    .sized(13.0F, 8.0F)
                    .clientTrackingRange(10)
                    .fireImmune()
                    .build("soulther_dragon"));

    public static void registerAttributes(EntityAttributeCreationEvent event) {
        event.put(SOUL_WRAITH.get(), SoulWraithEntity.createAttributes().build());
        event.put(VOIDLING.get(), VoidlingEntity.createAttributes().build());
        event.put(SOULTHER_DRAGON.get(), SoultherDragonEntity.createAttributes().build());
    }
}
