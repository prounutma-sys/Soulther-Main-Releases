package com.soulther.init;

import com.soulther.SoultherMod;
import com.soulther.fluid.SoultherFluidType;
import net.minecraft.core.Registry;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.level.material.Fluid;
import net.minecraft.world.level.material.FlowingFluid;
import net.minecraftforge.fluids.ForgeFlowingFluid;
import net.minecraftforge.fluids.FluidType;
import net.minecraftforge.registries.DeferredRegister;
import net.minecraftforge.registries.ForgeRegistries;
import net.minecraftforge.registries.RegistryObject;

import java.util.function.Supplier;

/**
 * Yeni sıvımız: Liquid Soul (Ruh Sıvısı).
 * Soulther boyutında lav/su yerine geçen, oyuncuya yavaş hasar veren mistik bir sıvı.
 */
public class ModFluids {

    public static final DeferredRegister<FluidType> FLUID_TYPES =
            DeferredRegister.create(net.minecraftforge.common.ForgeMod.FLUID_TYPES.get(), SoultherMod.MOD_ID);

    public static final DeferredRegister<Fluid> FLUIDS =
            DeferredRegister.create(ForgeRegistries.FLUIDS, SoultherMod.MOD_ID);

    public static final RegistryObject<FluidType> LIQUID_SOUL_TYPE = FLUID_TYPES.register("liquid_soul",
            () -> new SoultherFluidType(
                    FluidType.Properties.create()
                            .lightLevel(6)
                            .density(1200)
                            .viscosity(1500)
                            .canPushEntity(false)
                            .canSwim(true)
                            .canDrown(true)
            ));

    public static final RegistryObject<FlowingFluid> LIQUID_SOUL_SOURCE = FLUIDS.register("liquid_soul",
            () -> new ForgeFlowingFluid.Source(soulProperties()));

    public static final RegistryObject<FlowingFluid> LIQUID_SOUL_FLOWING = FLUIDS.register("flowing_liquid_soul",
            () -> new ForgeFlowingFluid.Flowing(soulProperties()));

    private static ForgeFlowingFluid.Properties soulProperties() {
        return new ForgeFlowingFluid.Properties(
                LIQUID_SOUL_TYPE, LIQUID_SOUL_SOURCE, LIQUID_SOUL_FLOWING)
                .slopeFindDistance(2)
                .levelDecreasePerBlock(2)
                .block(() -> ModBlocks.LIQUID_SOUL_BLOCK.get())
                .bucket(() -> ModItems.LIQUID_SOUL_BUCKET.get());
    }
}
